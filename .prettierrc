{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-zh"],
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "proseWrap": "preserve",
        "plugins": ["prettier-plugin-zh"]
      }
    }
  ]
}
