{
  "name": "employ-guard-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Employment Guard AI assistant · docs and tooling",
  "scripts": {
    "format": "prettier --write \"README.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"README.md\" \"docs/**/*.md\"",
    "lint:md": "markdownlint \"README.md\" \"docs/**/*.md\"",
    "lint:md:fix": "markdownlint --fix \"README.md\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "markdownlint-cli": "0.45.0",
    "prettier": "3.6.2",
    "prettier-plugin-zh": "0.7.0"
  }
}
